DISCORD_TOKEN=your_discord_bot_token
GOOGLE_API_KEY=your_gemini_api_key
DATA_DIR=
# On Render this is /var/data (set automatically by render.yaml)

# Website / dashboard (Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=1533047923829375056
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
SESSION_SECRET=change-this-to-a-long-random-string
WEB_HOST=127.0.0.1
WEB_PORT=8000
SITE_URL=https://5spartan9.github.io/Veritas-BotDC/
PANEL_URL=http://127.0.0.1:8000/dashboard
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Payments — Stripe (recommended: cards + optional PayPal in Stripe Dashboard)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Create Product → recurring Price, paste price_... here
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ULTRA=
# One-time Ultra Lifetime (~$79 US reference; create regional Prices in Stripe)
STRIPE_PRICE_ID_ULTRA_LIFETIME=
PREMIUM_PRICE_LABEL=$5.99 / month
ULTRA_PRICE_LABEL=$16.99 / month
ULTRA_LIFETIME_PRICE_LABEL=$79 once · forever

# Optional PayPal link (PayPal.me or hosted button)
# Example: https://paypal.me/YourName/4.99
PAYPAL_ME_URL=
PAYPAL_BUTTON_URL=
