DISCORD_TOKEN=your_discord_bot_token
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Website / dashboard (Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=1533047923829375056
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
SESSION_SECRET=change-this-to-a-long-random-string
WEB_HOST=127.0.0.1
WEB_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Payments — Stripe (recommended: cards + optional PayPal in Stripe Dashboard)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Create Product → recurring Price, paste price_... here
STRIPE_PRICE_ID=
PREMIUM_PRICE_LABEL=$4.99 / month

# Optional PayPal link (PayPal.me or hosted button)
# Example: https://paypal.me/YourName/4.99
PAYPAL_ME_URL=
PAYPAL_BUTTON_URL=
